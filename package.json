{
  "name": "micro-batch-store",
  "version": "0.1.0",
  "author": "Mateusz Sikora (https://sikora.software)",
  "description": "Minimal Redux-like store with microtask-batched notifications",
  "keywords": [
    "redux",
    "store",
    "state-management",
    "microtask",
    "queueMicrotask",
    "batching",
    "batched-updates",
    "lightweight",
    "tiny-redux",
    "performance",
    "typescript"
  ],
  "homepage": "https://github.com/sikora-software/micro-batch-store#readme",
  "bugs": {
    "url": "https://github.com/sikora-software/micro-batch-store/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.23.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sikora-software/micro-batch-store.git"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean --define.PACKAGE_VERSION \"\\\"$npm_package_version\\\"\" && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "tsup src/index.ts --format cjs,esm --watch --define.PACKAGE_VERSION \"\\\"$npm_package_version\\\"\"",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ]
}
